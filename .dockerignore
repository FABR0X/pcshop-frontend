# Keep the host's dependencies out of the image.
#
# Without this, `COPY . .` copies a Windows node_modules over the one `npm ci`
# just installed in the Linux build stage, and the native binaries and .bin
# shims no longer match the container. The image then fails with
# "node.exe: not found" even though the Dockerfile looks correct.
node_modules

# Build output is produced inside the image, never copied in from the host.
dist
build

# Secrets and local config. .env.example stays: it documents the variables.
.env
.env.*
!.env.example

.git
.gitignore
.dockerignore
Dockerfile

*.log
npm-debug.log*
.DS_Store
Thumbs.db

README.md
.vscode
.idea
