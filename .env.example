# Frontend build-time configuration.
#
# Copy to .env only if you need to override a default. In Docker the SPA talks
# to /api on its own origin and nginx proxies it, which is the setup you want.
#
# Leave VITE_API_BASE_URL unset in production: a relative path keeps the browser
# on one origin, so there is no CORS preflight and no second host to configure.

# Absolute URL of the API, for running the Vite dev server against a backend on
# a different port. Prefer the built-in /api proxy in vite.config.js instead.
# VITE_API_BASE_URL=http://localhost:4000/api

# Where `npm run dev` proxies /api. Defaults to http://localhost:4000.
# VITE_PROXY_TARGET=http://localhost:4000
